# Copy to .env.local for self-hosting. Never commit real values.
# Keep local-first mode unless you intentionally want account-backed cloud storage.
# "local" stores supported data in the encrypted on-device vault and makes no Supabase requests.
# "cloud" enables Supabase Auth and cloud-backed habits, journal, goals, planner, ideas, badges and social features.
VITE_DATA_MODE=local

# Required only when VITE_DATA_MODE=cloud
VITE_SUPABASE_URL=https://tptwhamashnikffubjpd.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_PROJECT_ID=tptwhamashnikffubjpd
